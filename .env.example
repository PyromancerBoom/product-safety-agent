# --- Gemini API key (default path) ---
# Get a key at https://aistudio.google.com/apikey.
GOOGLE_API_KEY=

# --- Vertex AI instead of a Gemini API key ---
# Remove or comment out GOOGLE_API_KEY above, authenticate with Google Cloud,
# and uncomment all three lines below. See Google ADK's Vertex AI setup docs.
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model override (optional)
# GEMINI_MODEL=gemini-2.5-flash

# --- Phoenix Cloud (optional tracing; required for the offline improver) ---
# Create a Phoenix API key at https://app.phoenix.arize.com.
PHOENIX_API_KEY=
# Copy your space URL from Phoenix Settings, including /s/your-space.
# Do not add /v1/traces; Phoenix builds the trace endpoint from this URL.
PHOENIX_COLLECTOR_ENDPOINT=
# Example: https://app.phoenix.arize.com/s/your-space
PHOENIX_PROJECT_NAME=shopsafe

# --- Exa web search (required — the agent needs live internet) ---
# Create a key at https://dashboard.exa.ai
EXA_API_KEY=

# --- Groq (optional provider for the live pipeline) ---
# The offline improver still uses Gemini.
# USE_GROQ=1
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Pipeline tuning (all optional, these are the defaults) ---
# PLANNER_MODEL=gemini-2.5-flash
# VERDICT_MODEL=gemini-2.5-flash
# JUDGE_MODEL=gemini-2.5-flash
# MAX_REFINEMENT_PASSES=2
# MAX_PLANNED_QUERIES=3
# EXA_NUM_RESULTS=5
# EXA_SNIPPET_CHARS=800
# AUDIT_PASS_THRESHOLD=0.85
